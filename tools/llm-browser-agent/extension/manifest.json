{
  "manifest_version": 3,
  "name": "llm Browser Agent",
  "version": "0.1.0",
  "description": "Connect llm-browser-agent to this Chrome profile.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage", "alarms", "declarativeNetRequest"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "llm Browser Agent",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
